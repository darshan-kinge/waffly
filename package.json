{
  "name": "waffly",
  "version": "0.1.0",
  "description": "Waffly — a typed, lightweight SDK for the WhatsApp Cloud API",
  "author": "Darshan Kinge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darshan-kinge/waffly.git"
  },
  "bugs": {
    "url": "https://github.com/darshan-kinge/waffly/issues"
  },
  "homepage": "https://github.com/darshan-kinge/waffly#readme",
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/PACKAGE_GUIDE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:audit": "publint --pack npm && attw --pack .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepack": "npm run clean && npm run build",
    "webhook:dev": "npm run build && node --env-file=.env examples/webhook-server.mjs",
    "clean": "rimraf dist"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-cloud-api",
    "whatsapp-business-api",
    "meta",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.10.0",
    "publint": "^0.3.25",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.8"
  }
}
